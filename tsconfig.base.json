{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@forged-fighter/core": ["packages/core/src/index.ts"],
      "@forged-fighter/combat": ["packages/combat/src/index.ts"],
      "@forged-fighter/netcode": ["packages/netcode/src/index.ts"]
    }
  }
}
